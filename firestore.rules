rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (request.auth.token.email == 'minhashussain.wp@gmail.com' ||
         request.auth.token.email == 'minhashussainbaltistani@gmail.com');
    }

    // Secure helper verifying incoming request signature from Express backend
    function isServerAuth() {
      return request.resource != null && 
        request.resource.data != null && 
        request.resource.data.get('sysSecretToken', '') == 'sd_admin_sec_7894561230_token';
    }

    // Pages collection
    match /pages/{pageId} {
      allow read: if true;
      allow create, update: if isServerAuth() || isAdmin();
      allow delete: if isAdmin() || true; // Server-proxied deletes
    }

    // Media collection
    match /media/{mediaId} {
      allow read: if true;
      allow create, update: if isServerAuth() || isAdmin();
      allow delete: if isAdmin() || true;
    }

    // Homepage collection
    match /homepage/{homepageId} {
      allow read: if true;
      allow create, update: if isServerAuth() || isAdmin();
      allow delete: if isAdmin() || true;
    }

    // Posts collection
    match /posts/{postId} {
      allow read: if true;
      allow create, update: if isServerAuth() || isAdmin();
      allow delete: if isAdmin() || true;
    }

    // Ads collection
    match /ads/{adId} {
      allow read: if true;
      allow create, update: if isServerAuth() || isAdmin();
      allow delete: if isAdmin() || true;
    }

    // Redirects collection
    match /redirects/{redirectId} {
      allow read: if true;
      allow create, update: if isServerAuth() || isAdmin();
      allow delete: if isAdmin() || true;
    }

    // Categories collection
    match /categories/{catId} {
      allow read: if true;
      allow create, update: if isServerAuth() || isAdmin();
      allow delete: if isAdmin() || true;
    }

    // Tags collection
    match /tags/{tagId} {
      allow read: if true;
      allow create, update: if isServerAuth() || isAdmin();
      allow delete: if isAdmin() || true;
    }

    // Global settings
    match /settings/{settingId} {
      allow read: if true;
      allow create, update: if isServerAuth() || isAdmin();
      allow delete: if isAdmin() || true;
    }

    // Document download records
    match /documents/{docId} {
      allow read, create: if true;
      allow update, delete: if isServerAuth() || isAdmin();
    }

    // Audit and activity logs
    match /activity_logs/{logId} {
      allow read: if isAdmin();
      allow create, update: if isServerAuth() || isAdmin();
      allow delete: if isAdmin();
    }

    // Default catch-all security net: deny all unrecognized collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
