rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        request.auth.token.email == 'minhashussainbaltistani@gmail.com';
    }

    // Public pages: published & not in trash are public to read
    match /pages/{pageId} {
      allow read: if resource == null || (resource.data.status == 'published' && resource.data.inTrash != true) || isAdmin();
      allow write: if isAdmin();
    }

    // Public blog posts & guides: published & not in trash are public to read
    match /posts/{postId} {
      allow read: if resource == null || (resource.data.status == 'published' && resource.data.inTrash != true) || isAdmin();
      allow write: if isAdmin();
    }

    // Ads: active ads can be read publicly
    match /ads/{adId} {
      allow read: if resource == null || resource.data.status == 'active' || isAdmin();
      allow write: if isAdmin();
    }

    // Redirects: active redirects can be read publicly
    match /redirects/{redirectId} {
      allow read: if resource == null || resource.data.status == 'active' || isAdmin();
      allow write: if isAdmin();
    }

    // Global settings & SEO configurations
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Document download records
    match /documents/{docId} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }

    // Audit logs & activity
    match /activity_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // Default deny all other documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
